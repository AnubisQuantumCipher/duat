[Unit]
Description=Project Vault scrub
After=ipad-storage.service

[Service]
Type=oneshot
ExecCondition=/usr/bin/python3 %h/Projects/duat/background_policy.py --kind scrub
ExecStart=/usr/bin/python3 %h/Projects/duat/scrub.py
UMask=0077
CPUWeight=10
Nice=19
TimeoutStartSec=infinity
IOSchedulingClass=idle
IOSchedulingPriority=0
