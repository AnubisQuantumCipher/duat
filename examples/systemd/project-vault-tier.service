[Unit]
Description=Offload explicitly enrolled inactive project outputs to iPad
After=ipad-storage.service

[Service]
Type=oneshot
ExecCondition=/usr/bin/python3 %h/Projects/duat/background_policy.py --kind tier
ExecStart=/usr/bin/python3 %h/Projects/duat/tier_queue.py
TimeoutStartSec=infinity
CPUWeight=10
Nice=19
IOSchedulingClass=idle
IOSchedulingPriority=0
UMask=0077
