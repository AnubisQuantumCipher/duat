[Unit]
Description=Verified iPad project backups (preserve all local originals)
After=ipad-storage.service

[Service]
Type=oneshot
ExecCondition=/usr/bin/python3 %h/Projects/duat/background_policy.py --kind backup
ExecStart=/usr/bin/python3 %h/Projects/duat/scheduled.py
TimeoutStartSec=infinity
CPUWeight=10
Nice=19
IOSchedulingClass=idle
IOSchedulingPriority=0
UMask=0077
